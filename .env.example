# Copy this file to .env and fill values locally. Never commit .env.

NEXTCLOUD_ADMIN_USER=change-me
NEXTCLOUD_ADMIN_PASSWORD=change-me

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me

# Replace with the actual hostname used by your reverse proxy.
NEXTCLOUD_TRUSTED_DOMAIN=example.ts.net

# Talk HPB secrets; generate unique random values locally.
TURN_SECRET=change-me
SIGNALING_SECRET=change-me
INTERNAL_SECRET=change-me

# Local ports used by the current Windows deployment.
NEXTCLOUD_HTTP_PORT=8081
NEXTCLOUD_PROXY_PORT=8083
TALK_HPB_SIGNALING_PORT=8082
TALK_HPB_TURN_PORT=3478
